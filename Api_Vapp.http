############################################
### Wallet Referral (معرفی شارژ کیف پول)
############################################

### اطلاعات رفرال کاربر
GET {{Api_Vapp_HostAddress}}/api/Wallet/referral
Authorization: Bearer {{token}}

### اعتبارسنجی کد معرفی + پیش‌نمایش مبالغ
POST {{Api_Vapp_HostAddress}}/api/Wallet/referral/validate
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "amount": 1500000,
  "referralCode": "@u2"
}

### شارژ کیف پول با کد معرفی
POST {{Api_Vapp_HostAddress}}/api/Wallet/charge
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "amount": 1500000,
  "gateway": "Behpardakht",
  "referralCode": "@u2"
}

### پروفایل (شامل referralCode)
GET {{Api_Vapp_HostAddress}}/api/User/profile
Authorization: Bearer {{token}}

### به‌روزرسانی پروفایل (بدون تغییر شماره — شماره فقط با OTP)
POST {{Api_Vapp_HostAddress}}/api/User/profile/update
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "fullName": "نام تست"
}

### درخواست تغییر شماره موبایل — ارسال OTP به شماره جدید
POST {{Api_Vapp_HostAddress}}/api/User/profile/change-phone/request
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "phoneNumber": "09121234567"
}

### تایید OTP و اعمال تغییر شماره
POST {{Api_Vapp_HostAddress}}/api/User/profile/change-phone/verify
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "phoneNumber": "09121234567",
  "otpCode": "1234"
}

### ارسال مجدد OTP تغییر شماره
POST {{Api_Vapp_HostAddress}}/api/User/profile/change-phone/resend
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "phoneNumber": "09121234567"
}

