@Api_Vapp_HostAddress = http://localhost:5054
@scraperApiKey = dev-local-key
@token = REPLACE_ME
@taskId = REPLACE_ME

GET {{Api_Vapp_HostAddress}}/weatherforecast/
Accept: application/json

###

# --- LuckyWheel (گردونه شانس) — نیاز به JWT یا Development:DisableAuth=true ---

### ایجاد پیش‌نویس (مرحله ۱)
POST {{Api_Vapp_HostAddress}}/api/LuckyWheel
Content-Type: application/json

{
  "title": "گردونه نوروز",
  "description": "شانس خود را امتحان کنید",
  "saveToPhonebook": false,
  "notebookIds": []
}

### به‌روزرسانی جوایز (مرحله ۲) — wheelId را جایگزین کنید
POST {{Api_Vapp_HostAddress}}/api/LuckyWheel/1/items/add
Content-Type: application/json

{
  "items": [
    { "name": "۱۰٪ تخفیف", "probability": 30, "displayOrder": 1 },
    { "name": "۲۰٪ تخفیف", "probability": 30, "displayOrder": 2 },
    { "name": "پوچ", "probability": 40, "displayOrder": 3 }
  ]
}

### افزودن یک یا چند آیتم جدید (دکمه +)
POST {{Api_Vapp_HostAddress}}/api/LuckyWheel/1/items/add
Content-Type: application/json

{
  "items": [
    {
      "name": "۳۰٪ تخفیف",
      "probability": 20,
      "displayOrder": 4
    }
  ]
}

### به‌روزرسانی جزئی جوایز (ویرایش درصد/نام/ترتیب)
POST {{Api_Vapp_HostAddress}}/api/LuckyWheel/1/items/update
Content-Type: application/json

{
  "items": [
    {
      "id": 5,
      "name": "درصد جدید",
      "probability": 50,
      "displayOrder": 1
    },
    {
      "name": "جایزه جدید",
      "probability": 10,
      "displayOrder": 5
    }
  ]
}

### جزئیات گردونه (Preview)
GET {{Api_Vapp_HostAddress}}/api/LuckyWheel/1

### انتشار و دریافت لینک
POST {{Api_Vapp_HostAddress}}/api/LuckyWheel/1/publish
Content-Type: application/json

{
  "slug": "norooz-wheel"
}

### لیست گردونه‌ها
GET {{Api_Vapp_HostAddress}}/api/LuckyWheel?pageNumber=1&pageSize=10

### ویرایش اطلاعات اصلی (تنظیمات)
POST {{Api_Vapp_HostAddress}}/api/LuckyWheel/1/update-info
Content-Type: application/json

{
  "title": "گردونه جشن تابستانه",
  "description": "توضیح جدید",
  "slug": "summer-festival",
  "saveToPhonebook": true,
  "notebookIds": [1]
}

### فعال/غیرفعال (تنظیمات)
POST {{Api_Vapp_HostAddress}}/api/LuckyWheel/1/toggle-active
Content-Type: application/json

{
  "isActive": false
}

### حذف گردونه
POST {{Api_Vapp_HostAddress}}/api/LuckyWheel/1/delete

### ارسال سریع گردونه به مخاطب
POST {{Api_Vapp_HostAddress}}/api/LuckyWheel/quick-send
Content-Type: application/json

{
  "contactId": 1,
  "luckyWheelId": 1
}

###

# --- FormPublic (فرم عمومی) — بدون Auth ---

### دریافت schema فرم منتشرشده
GET {{Api_Vapp_HostAddress}}/api/FormPublic/contact-form

### ثبت مشخصات تماس و ارسال کد تایید
POST {{Api_Vapp_HostAddress}}/api/FormPublic/contact-form/register
Content-Type: application/json

{
  "firstName": "علی",
  "lastName": "رضایی",
  "participantMobile": "09121112233"
}

### تأیید کد OTP
POST {{Api_Vapp_HostAddress}}/api/FormPublic/contact-form/verify-otp
Content-Type: application/json

{
  "accessToken": "{{publicParticipantToken}}",
  "otpCode": "1234"
}

### ارسال مجدد کد تایید
POST {{Api_Vapp_HostAddress}}/api/FormPublic/contact-form/resend-otp
Content-Type: application/json

{
  "accessToken": "{{publicParticipantToken}}"
}

### ثبت پاسخ فرم (accessToken تأییدشده)
POST {{Api_Vapp_HostAddress}}/api/FormPublic/contact-form/submit
Content-Type: application/json

{
  "accessToken": "{{publicParticipantToken}}",
  "values": {
    "full_name": "علی رضایی",
    "mobile": "09121112233"
  }
}

###

# --- LuckyWheelPublic (گردونه عمومی) — بدون Auth ---

### دریافت اطلاعات گردونه
GET {{Api_Vapp_HostAddress}}/api/LuckyWheelPublic/norooz-wheel

### ثبت مشخصات تماس (قبل از چرخش)
POST {{Api_Vapp_HostAddress}}/api/LuckyWheelPublic/norooz-wheel/register
Content-Type: application/json

{
  "firstName": "سارا",
  "lastName": "محمدی",
  "participantMobile": "09123334455"
}

### تأیید کد OTP
POST {{Api_Vapp_HostAddress}}/api/LuckyWheelPublic/norooz-wheel/verify-otp
Content-Type: application/json

{
  "accessToken": "{{publicParticipantToken}}",
  "otpCode": "1234"
}

### ارسال مجدد کد تایید
POST {{Api_Vapp_HostAddress}}/api/LuckyWheelPublic/norooz-wheel/resend-otp
Content-Type: application/json

{
  "accessToken": "{{publicParticipantToken}}"
}

### چرخش گردونه (accessToken تأییدشده)
POST {{Api_Vapp_HostAddress}}/api/LuckyWheelPublic/norooz-wheel/spin
Content-Type: application/json

{
  "accessToken": "{{publicParticipantToken}}"
}

