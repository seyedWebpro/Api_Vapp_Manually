# کپی روی سرور (اختیاری):
#   cp devops/backup/backup.env.example devops/backup/backup.env
#   chmod 600 devops/backup/backup.env
# SA_PASSWORD از ~/Api_Vapp_Manually/docker/.env خوانده می‌شود؛ اینجا فقط override.

# نام دیتابیس
DB_NAME=DbVapp

# کانتینر SQL Server
SQL_CONTAINER=vapp_sqlserver_prod

# مسیر بکاپ روی host (همان volume ../backups در docker-compose.production.yml)
BACKUP_ROOT=/root/Api_Vapp_Manually/backups

# نگه‌داری بکاپ روزانه (روز)
KEEP_DAILY=14

# نگه‌داری بکاپ هفتگی (تعداد فایل؛ هر یکشنبه ساعت 03:15)
KEEP_WEEKLY=8

# حداکثر سن latest.bak برای health-check (ساعت) — پیش‌فرض ۳۰ ≈ یک روز + حاشیه
MAX_BACKUP_AGE_HOURS=30

# آپلود ابری با rclone (خالی = offsite غیرفعال)
# Google Drive (بعد از rclone config — راهنما: backup/GOOGLE_DRIVE_OFFSITE.md):
# RCLONE_REMOTE=vapp-gdrive:vapp-db-backups/DbVapp
# یا: bash devops/scripts/setup-gdrive-offsite.sh

# فلگ‌های rclone
# RCLONE_FLAGS=--transfers 2 --checkers 4 --retries 3 --low-level-retries 10 --checksum

# نگه‌داری offsite (روز)
KEEP_REMOTE_DAILY=30
KEEP_REMOTE_WEEKLY_DAYS=56

# زمان cron (فقط برای install-db-backup-cron.sh) — حتماً داخل کوتیشن
CRON_DAILY="0 3 * * *"
CRON_WEEKLY="15 3 * * 0"
CRON_HEALTH="30 5 * * *"

# چک فضای دیسک قبل از بکاپ
MIN_FREE_DISK_MULTIPLIER=2.0
MIN_FREE_DISK_MB=512

# صبر قبل از بکاپ
SQL_READY_TIMEOUT_SEC=180
SQL_READY_INTERVAL_SEC=5
BACKUP_SQL_TIMEOUT_SEC=3600

# دسترسی فایل‌ها
BACKUP_DIR_MODE=700
BACKUP_FILE_MODE=600

# وب‌هوک اختیاری (Slack / Discord / Telegram bot gateway / generic JSON)
# NOTIFY_WEBHOOK_URL=https://hooks.example.com/vapp-backup
# NOTIFY_ON_SUCCESS=false

# مالک پوشهٔ بکاپ برای SQL Server داخل Docker (پیش‌فرض: auto)
# MSSQL_UID=10001
# MSSQL_GID=0
