# Nginx reverse proxy — نمونه (مرجع؛ نصب واقعی با apply-nginx.sh)
#
# اپ:   vapplication.ir  → /etc/nginx/sites-available/vapp
# درگاه: api.v-application.ir → /etc/nginx/sites-available/vapp-gateway (جدا)
#
# نصب: DOMAIN_HOST=vapplication.ir bash devops/scripts/apply-nginx.sh

# --- اپ (خلاصه) ---
server {
    listen 443 ssl;
    server_name vapplication.ir www.vapplication.ir;

    # ssl_certificate .../vapplication.ir/fullchain.pem  (Certbot)

    client_max_body_size 2048M;

    location /api { proxy_pass http://127.0.0.1:8080; }
    location /health { proxy_pass http://127.0.0.1:8080; }
    location /swagger { proxy_pass http://127.0.0.1:8080; }
    location /uploads { proxy_pass http://127.0.0.1:8080; }

    location ~ ^/(form|wheel|card|book|preview)(/.*)?$ {
        root /var/www/vapp-public;
        try_files /index.html =404;
    }

    location / {
        root /var/www/vapp-admin;
        try_files $uri $uri/ /index.html;
    }
}

